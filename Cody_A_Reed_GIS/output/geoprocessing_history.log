ALGORITHM|~|2026-10-16 20:22:27|~|processing.run("qgis:executesql", {'INPUT_DATASOURCES':['/Users/codyarliereed/DDOT-assessment/CODY_A_REED_GIS/data/CODY_A_REED_GIS.gpkg|layername=permits_snapped_26985','/Users/codyarliereed/DDOT-assessment/CODY_A_REED_GIS/data/CODY_A_REED_GIS.gpkg|layername=requests_nearest','/Users/codyarliereed/DDOT-assessment/CODY_A_REED_GIS/data/CODY_A_REED_GIS.gpkg|layername=subblocks'],'INPUT_QUERY':"-- Enrich the roadway subblocks with permit and service request summaries\n-- input1 = permits_snapped_26985, input2 = requests_nearest, input3 = subblocks\nSELECT s.*,\n       COALESCE(p.permit_count, 0)  AS permit_count,   -- distinct permits on the block\n       COALESCE(p.permit_rows, 0)   AS permit_rows,    -- permit work locations on the block\n       date(p.max_exp)              AS max_expiration,\n       COALESCE(r.request_count, 0) AS request_count,\n       date(r.max_init_et)          AS max_initiated,\n       r.max_init_et                AS max_initiated_et,\n       CASE WHEN p.permit_rows > 0 THEN 1 ELSE 0 END AS has_permit,\n       CASE WHEN r.request_count > 0 THEN 1 ELSE 0 END AS has_request,\n       CASE WHEN p.permit_rows > 0 AND r.request_count > 0 THEN 1 ELSE 0 END AS has_both\nFROM input3 AS s\nLEFT JOIN (SELECT sb_SUBBLOCKKEY               AS k,\n                  COUNT(DISTINCT PermitNumber) AS permit_count,\n                  COUNT(*)                     AS permit_rows,\n                  MAX(ExpirationDate)          AS max_exp\n           FROM input1\n           GROUP BY sb_SUBBLOCKKEY) AS p\n       ON p.k = s.SUBBLOCKKEY\nLEFT JOIN (SELECT sb_SUBBLOCKKEY AS k,\n                  COUNT(*)       AS request_count,\n                  -- UTC to Eastern: EST (-5 h) from 2025-11-02 to 2026-03-08, EDT (-4 h) otherwise\n                  datetime(MAX(INITIATEDDATE),\n                           CASE WHEN MAX(INITIATEDDATE) >= '2025-11-02T06:00:00'\n                                 AND MAX(INITIATEDDATE) <  '2026-03-08T07:00:00'\n                                THEN '-5 hours' ELSE '-4 hours' END) AS max_init_et\n           FROM input2\n           GROUP BY sb_SUBBLOCKKEY) AS r\n       ON r.k = s.SUBBLOCKKEY\n",'INPUT_UID_FIELD':'','INPUT_GEOMETRY_FIELD':'','INPUT_GEOMETRY_TYPE':0,'INPUT_GEOMETRY_CRS':QgsCoordinateReferenceSystem('EPSG:26985'),'OUTPUT':'ogr:dbname=\'/Users/codyarliereed/DDOT-assessment/CODY_A_REED_GIS/data/CODY_A_REED_GIS.gpkg\' table="subblocks_enriched" (geom)'})
